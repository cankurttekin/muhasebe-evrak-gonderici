# Sunucu Portu
PORT=5000

# Zirve Veri Klasörü Yolu (Örn: /zirvedata, /mnt/zirvedata veya C:/zirvenet/zirvedata)
# Test için boş bırakılırsa otomatik olarak ./mock_zirvedata klasörünü kullanır
ZIRVE_DATA_PATH=./mock_zirvedata

# Uygulama Veritabanı ve WhatsApp Oturum Anahtarları Klasörü
DATA_DIR=./data

# Test amaçlı Simülasyon Modu (true: WhatsApp bağlanmadan test gönderimi yapar, false: gerçek WhatsApp)
WA_SIMULATION=false

# Varsayılan WhatsApp Mesaj Şablonu
DEFAULT_MESSAGE_TEMPLATE=Sayın {UNVAN},\n\n{DONEM} dönemine ait {BELGELER} ekte bilgilerinize sunulmuştur.\n\nBilgilerinize arz eder, iyi çalışmalar dileriz.\n\nMuhasebe Departmanı
